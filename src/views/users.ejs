<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User List</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="container">
        <header>
            <h1>Registered Users</h1>
            <nav>
                <a href="/">Dashboard</a>
                <a href="/users/profile">My Profile</a>
                <a href="/auth/logout">Logout</a>
            </nav>
        </header>
        <main>
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Joined</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(u=> { %>
                        <tr>
                            <td>
                                <%= u.displayName %>
                            </td>
                            <td>
                                <%= u.email %>
                            </td>
                            <td>
                                <%= new Date(u.createdAt).toLocaleDateString() %>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </main>
    </div>
</body>

</html>